Algoritmo denei
  Definir dni Como Entero;
  Definir rest Como Entero;

  Escribir "Dime el numero del dni";
  Leer dni;
  rest:=dni Mod 23;
  Segun rest Hacer
    0: Escribir dni, "T";
    1: Escribir dni, "R";
    2: Escribir dni, "W";
    3: Escribir dni, "A";
    4: Escribir dni, "G";
    5: Escribir dni, "M";
    6: Escribir dni, "Y";
    7: Escribir dni, "F";
    8: Escribir dni, "P";
    9: Escribir dni, "D";
    10: Escribir dni, "X";
    11: Escribir dni, "B";
    12: Escribir dni, "N";
    13: Escribir dni, "J";
    14: Escribir dni, "Z";
    15: Escribir dni, "S";
    16: Escribir dni, "Q";
    17: Escribir dni, "V";
    18: Escribir dni, "H";
    19: Escribir dni, "L";
    20: Escribir dni, "C";
    21: Escribir dni, "K";
    22: Escribir dni, "E";
    De Otro Modo: Escribir " NO ESTOY PREPARADO PARA ESTO";
  FinSegun
FinAlgoritmo
